{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "failure-bundle.schema.json",
  "type": "object",
  "required": ["schema_version", "generation", "failed_gates", "patterns", "case_evidence", "next_generation_constraints"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "generation": { "type": "string", "pattern": "^G[0-9]{4}$" },
    "failed_gates": {
      "type": "array",
      "items": { "enum": ["small_preference", "small_content", "large_preference", "large_content"] },
      "uniqueItems": true
    },
    "patterns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "case_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scenario_id", "summary", "artifact_paths"],
        "properties": {
          "scenario_id": { "type": "string", "pattern": "^[SL][0-9]{2}$" },
          "summary": { "type": "string", "minLength": 1 },
          "artifact_paths": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "next_generation_constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
