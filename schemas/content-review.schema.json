{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-review.schema.json",
  "type": "object",
  "required": ["schema_version", "suite", "shard", "judge_thread_id", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "suite": { "enum": ["small", "large"] },
    "shard": { "type": "integer", "minimum": 1 },
    "judge_thread_id": { "type": "string", "pattern": "^T-[0-9a-f-]+$" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenario_id", "findings", "uncertainties"],
        "properties": {
          "scenario_id": { "type": "string", "pattern": "^[SL][0-9]{2}$" },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["classification", "explanation", "evidence"],
              "properties": {
                "classification": { "enum": ["candidate_only", "shared", "baseline_only"] },
                "explanation": { "type": "string", "minLength": 1 },
                "evidence": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "uncertainties": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
