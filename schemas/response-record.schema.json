{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "response-record.schema.json",
  "description": "Binds one stored answer to the thread that produced it. References set mode and leave generation null; generation runs set generation and leave mode null.",
  "type": "object",
  "required": ["schema_version", "scenario_id", "suite", "mode", "generation", "thread_id", "answer_path", "transcript_path"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 2 },
    "scenario_id": { "type": "string", "pattern": "^[SL][0-9]{2}$" },
    "suite": { "enum": ["small", "large"] },
    "mode": {
      "anyOf": [
        { "type": "null" },
        { "enum": ["grok46-high", "grok46-ultra"] }
      ]
    },
    "generation": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^G[0-9]{4}$" }
      ]
    },
    "thread_id": { "type": "string", "pattern": "^T-[0-9a-f-]+$" },
    "answer_path": { "type": "string", "minLength": 1 },
    "transcript_path": { "type": "string", "minLength": 1 },
    "superseded_thread_ids": {
      "description": "Threads for this scenario that did not count (errored, stalled, or asked instead of answering).",
      "type": "array",
      "items": { "type": "string", "pattern": "^T-[0-9a-f-]+$" }
    }
  },
  "additionalProperties": false
}
