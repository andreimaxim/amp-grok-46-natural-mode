{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "response-record.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "scenario_id",
    "suite",
    "scenario_path",
    "scenario_sha256",
    "mode",
    "generation",
    "thread_id",
    "completed",
    "revision_ok",
    "rails_revision",
    "final_answer_path",
    "final_answer_sha256",
    "final_answer_bytes"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "scenario_id": { "type": "string", "pattern": "^[SL][0-9]{2}$" },
    "suite": { "enum": ["small", "large"] },
    "scenario_path": { "type": "string", "minLength": 1 },
    "scenario_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mode": { "enum": ["high", "grok46-baseline", "grok46-candidate"] },
    "generation": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^G[0-9]{4}$" }
      ]
    },
    "thread_id": { "type": "string", "pattern": "^T-[0-9a-f-]+$" },
    "completed": { "const": true },
    "revision_ok": { "const": true },
    "rails_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "final_answer_path": { "type": "string", "minLength": 1 },
    "final_answer_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "final_answer_bytes": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
