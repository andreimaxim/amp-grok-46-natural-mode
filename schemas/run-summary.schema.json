{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-summary.schema.json",
  "type": "object",
  "required": ["schema_version", "generation", "parent_generation", "small", "large", "decision"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 2 },
    "generation": { "type": "string", "pattern": "^G[0-9]{4}$" },
    "parent_generation": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^G[0-9]{4}$" }
      ]
    },
    "small": { "$ref": "#/$defs/suiteResult" },
    "large": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/suiteResult" }
      ]
    },
    "decision": { "enum": ["failed_small", "failed_large", "final"] }
  },
  "$defs": {
    "suiteResult": {
      "type": "object",
      "required": ["scenario_count", "matches", "threshold", "passed"],
      "properties": {
        "scenario_count": { "type": "integer", "minimum": 1 },
        "matches": { "type": "integer", "minimum": 0 },
        "threshold": { "type": "integer", "minimum": 1 },
        "passed": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
