{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blind-map.schema.json",
  "type": "object",
  "required": ["schema_version", "suite", "seed", "assignments"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "suite": { "enum": ["small", "large"] },
    "seed": { "type": "string", "minLength": 1 },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenario_id", "candidate_label", "baseline_label"],
        "properties": {
          "scenario_id": { "type": "string", "pattern": "^[SL][0-9]{2}$" },
          "candidate_label": { "enum": ["A", "B"] },
          "baseline_label": { "enum": ["A", "B"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
